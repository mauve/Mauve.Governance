<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mauve.Governance.TestResults\Mauve.Governance.TestResults.csproj" />
    <ProjectReference Include="..\Mauve.Governance.Traceability\Mauve.Governance.Traceability.csproj" />
    <ProjectReference Include="..\Mauve.Governance.Requirements\Mauve.Governance.Requirements.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mauve.Governance.TestResults.Tests" />
    <EmbeddedResource Include="../templates/**/*" LogicalName="GovernanceTemplate/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>governance</ToolCommandName>
    <PackageId>Mauve.Governance.Tool</PackageId>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
